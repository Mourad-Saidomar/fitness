# Environnement d'exécution (development | production)
NODE_ENV=production

# Port et hôte d'écoute (fournis automatiquement par Alwaysdata en production)
PORT=3000
HOST=0.0.0.0

# Configuration MariaDB (Alwaysdata : mysql-saidomar.alwaysdata.net)
DB_HOST=mysql-saidomar.alwaysdata.net
DB_PORT=3306
DB_NAME=saidomar_fitness
DB_USER=saidomar
DB_PASSWORD=A_RENSEIGNER_DANS_ALWAYSDATA

# Authentification JWT
JWT_SECRET=A_RENSEIGNER_SECRET_FORT_PRODUCTION
JWT_EXPIRES_IN=1h

# Origine autorisée pour le Front-end Vue.js (CORS)
CORS_ORIGIN=https://fitness-frontend.vercel.app
